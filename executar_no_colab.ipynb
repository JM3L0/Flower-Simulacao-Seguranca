    "## 3. Upload ou Download dos Arquivos do Projeto\n",
    "\n",
    "Faça o upload do arquivo `projeto_flower.zip` (ou dos arquivos do projeto) para o Colab."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import zipfile\n",
    "from google.colab import files\n",
    "\n",
    "# Se o projeto_flower.zip já foi enviado ou clonado, extrai automaticamente\n",
    "if not os.path.exists('quickstart-pytorch'):\n",
    "    if os.path.exists('projeto_flower.zip'):\n",
    "        with zipfile.ZipFile('projeto_flower.zip', 'r') as zip_ref:\n",
    "            zip_ref.extractall('.')\n",
    "        print('✔ Projeto extraído do ZIP com sucesso!')\n",
    "    else:\n",
    "        print('Faça o upload do seu ZIP contendo a pasta quickstart-pytorch:')\n",
    "        uploaded = files.upload()\n",
    "        for fn in uploaded.keys():\n",
    "            with zipfile.ZipFile(fn, 'r') as zip_ref:\n",
    "                zip_ref.extractall('.')\n",
    "            print(f'✔ {fn} extraído com sucesso!')\n",
    "\n",
    "# Instala o pacote do motor local\n",
    "!pip install -q -e ./quickstart-pytorch\n",
    "print('✔ Ambiente pronto para execução!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Executar as Baterias Experimentais do Artigo 1 (em GPU)\n",
    "\n",
    "Esta célula executa as 4 defesas (`FedAvg`, `FedMedian`, `Krum`, `Bulyan`) com 3 repetições estatísticas (seeds 42, 43, 44) sob ataque furtivo `targeted_backdoor` em dados heterogêneos Non-IID ($\alpha=0.1$)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess\n",
    "import time\n",
    "\n",
    "%cd /content/quickstart-pytorch\n",
    "\n",
    "# Lista de experimentos planejados (4 defesas x 3 seeds estatísticas)\n",
    "defesas = [\"FedAvg\", \"FedMedian\", \"Krum\", \"Bulyan\"]\n",
    "seeds = [42, 43, 44]\n",
    "attack = \"targeted_backdoor\"\n",
    "poison_rate = 0.4\n",
    "alpha = 0.1\n",
    "rounds = 10\n",
    "\n",
    "total = len(defesas) * len(seeds)\n",
    "atual = 1\n",
    "\n",
    "print(f\"Iniciando bateria com {total} execuções em GPU T4...\\n\")\n",
    "\n",
    "for defesa in defesas:\n",
    "    for seed in seeds:\n",
    "        print(f\"[{atual:02d}/{total}] Executando: {defesa} | Seed: {seed} | Ataque: {attack} (α={alpha})...\")\n",
    "        run_cfg = f\"defense_mode='{defesa}' attack_type='{attack}' poison_rate={poison_rate} dirichlet_alpha={alpha} num-server-rounds={rounds} seed={seed}\"\n",
    "        cmd = f'flwr run . --stream --run-config \"{run_cfg}\"'\n",
    "        \n",
    "        # Executa no terminal com GPU\n",
    "        res = subprocess.run(cmd, shell=True)\n",
    "        \n",
    "        # Limpeza do Ray para evitar vazamento de memória GPU\n",
    "        subprocess.run(\"ray stop\", shell=True, capture_output=True)\n",
    "        time.sleep(2)\n",
    "        atual += 1\n",
    "\n",
    "print(\"\\n✔ Todas as simulações em GPU foram concluídas com sucesso!\")"
   ]
  },
  {
   "cell_type": "markdown",
